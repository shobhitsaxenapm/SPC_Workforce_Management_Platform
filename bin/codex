#!/usr/bin/env bash
set -e

# If CODEX_CMD is set in environment, run it.
if [ -n "$CODEX_CMD" ]; then
  exec /bin/bash -lc "$CODEX_CMD"
fi

# Look for .codexrc in project or home dir
if [ -f ".codexrc" ]; then
  CMD="$(head -n 1 .codexrc)"
  if [ -n "$CMD" ]; then
    exec /bin/bash -lc "$CMD"
  fi
fi

if [ -f "$HOME/.codexrc" ]; then
  CMD="$(head -n 1 "$HOME/.codexrc")"
  if [ -n "$CMD" ]; then
    exec /bin/bash -lc "$CMD"
  fi
fi

cat <<EOF >&2
No codex command configured. Set the CODEX_CMD environment variable or create a .codexrc file containing the command to run your Codex CLI/account.

Examples:
  export CODEX_CMD='open https://codex.example.com'
  # or
  echo "my-codex-cli login" > .codexrc

Then run: codex
EOF
exit 2
